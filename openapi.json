{
  "components": {
    "schemas": {
      "ErrorDetail": {
        "description": "Machine-readable error detail included in error envelopes.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Concrete non-2xx response envelope.",
        "properties": {
          "data": {
            "title": "Data",
            "type": "null"
          },
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "success": {
            "const": false,
            "default": false,
            "title": "Success",
            "type": "boolean"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthEnvelope": {
        "description": "Typed envelope for health check endpoints.",
        "properties": {
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HealthStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorDetail"
              },
              {
                "type": "null"
              }
            ]
          },
          "success": {
            "title": "Success",
            "type": "boolean"
          }
        },
        "required": [
          "success"
        ],
        "title": "HealthEnvelope",
        "type": "object"
      },
      "HealthStatus": {
        "description": "Health check dependency status.",
        "properties": {
          "db_ok": {
            "title": "Db Ok",
            "type": "boolean"
          },
          "redis_ok": {
            "title": "Redis Ok",
            "type": "boolean"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "db_ok",
          "redis_ok"
        ],
        "title": "HealthStatus",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "REST API for the Swarn Bharat platform.\n\n### Architecture & Contracts\n- All responses adhere to standard envelopes: `ApiResponse[T]` on success and `ErrorResponse` on failure.\n- Authentication uses Bearer JWT tokens. Access tokens expire in 15 minutes; refresh tokens expire in 7 days with single-use rotation.\n- Rate limiting is enforced using fixed windows with standard 429 status and `Retry-After` headers.\n- Degraded downstream dependencies trigger 503 Service Unavailable with `Retry-After` headers.",
    "title": "Swarn Bharat API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "description": "Returns 200 OK as long as the application process is running.",
        "operationId": "health-live",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthEnvelope"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "One or more dependencies unavailable"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "Health"
        ]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "description": "Readiness probe returning 503 when downstream dependencies are degraded.",
        "operationId": "health-ready",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthEnvelope"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthEnvelope"
                }
              }
            },
            "description": "Dependencies degraded or unreachable"
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "Health"
        ]
      }
    }
  }
}
