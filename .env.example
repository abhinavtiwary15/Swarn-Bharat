# App
APP_ENV=development
ENFORCE_HTTPS=false
# Comma-separated or JSON array accepted for list fields:
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:5500

# OpenAPI (optional — defaults match what's shown)
API_TITLE=Swarn Bharat API
API_VERSION=1.0.0
# Set API_DOCS_URL=null to disable Swagger UI in production
API_DOCS_URL=/api/v1/docs
API_REDOC_URL=/api/v1/redoc
OPENAPI_URL=/api/v1/openapi.json

# Database
DATABASE_URL=postgresql+asyncpg://swarnbharat:change_me@localhost:5432/swarnbharat
POSTGRES_USER=swarnbharat
POSTGRES_PASSWORD=change_me

# Redis (DB indices are the single source of truth; URLs are derived)
REDIS_BASE_URL=redis://localhost:6379
REDIS_DB_CELERY_BROKER=0
REDIS_DB_CELERY_RESULT=1
REDIS_DB_TOKENS=2
REDIS_DB_RATE_LIMIT=3
REDIS_DB_LOGIN_THROTTLE=4
# CELERY_BROKER_URL and CELERY_RESULT_BACKEND are NOT set here —
# they are computed from REDIS_BASE_URL + REDIS_DB_CELERY_* automatically.

# JWT
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=REPLACE_WITH_32_PLUS_RANDOM_BYTES_BASE64
JWT_REFRESH_SECRET_KEY=REPLACE_WITH_DIFFERENT_32_PLUS_RANDOM_BYTES_BASE64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_GRACE_WINDOW_SECONDS=30

# Google OAuth (optional — comment out to disable POST /auth/google/token)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET is not required for the
# ID-token validation flow used by this API.

# Login throttling
LOGIN_RATE_LIMIT_TIMES=5
LOGIN_RATE_LIMIT_SECONDS=60
MAX_LOGIN_ATTEMPTS=10
LOGIN_LOCKOUT_SECONDS=900
